{
  "name": "@plantswap/uikit",
  "version": "0.1.7",
  "description": "Set of UI components for plantswap projects",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": "https://github.com/plantswapfinance/plantswapfinance-toolkit/tree/master/packages/plantswap-uikit",
  "license": "MIT",
  "scripts": {
    "start": "yarn storybook",
    "build": "rollup -c && tsc -d --emitDeclarationOnly --declarationDir dist",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "format:check": "prettier --check --loglevel error 'src/**/*.{js,jsx,ts,tsx}'",
    "format:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx}'",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "jest",
    "prepublishOnly": "yarn build"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-styled-components": "^2.3.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-links": "^10.0.0",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/cli": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-webpack5": "^10.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest-styled-components": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@rollup/plugin-url": "^8.0.0",
    "styled-components": "^6.0.0",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^19.0.0",
    "react-dom": "^17.0.2 || ^19.0.0",
    "react-router-dom": "^5.2.0 || ^7.0.0",
    "styled-components": "^5.2.3 || ^6.0.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.9.2",
    "@types/lodash": "^4.14.168",
    "@types/styled-system": "^5.1.10",
    "lodash": "^4.17.20",
    "react-popper": "^2.2.5",
    "react-transition-group": "^4.4.1",
    "styled-system": "^5.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "resolutions": {
    "react-docgen": "^8.0.0"
  }
}
